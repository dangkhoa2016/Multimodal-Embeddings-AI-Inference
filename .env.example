# Generate a unique token: python -c 'import secrets; print(secrets.token_urlsafe(48))'
VISION_EMBEDDINGS_API_TOKEN=REPLACE_WITH_RANDOM_SECRET
# mock = deterministic integration stub; local = actual local GPU inference
VISION_EMBEDDINGS_BACKEND=mock
VISION_EMBEDDINGS_MAX_IMAGE_BYTES=5242880
VISION_EMBEDDINGS_MAX_BATCH_SIZE=8
# Per-gateway-instance inference guards; NOT a global quota or spending cap.
VISION_EMBEDDINGS_MAX_EMBEDDINGS_PER_MINUTE=120
VISION_EMBEDDINGS_MAX_INFLIGHT_REQUESTS=4
# Modal inference deadline, including GPU scheduling and execution; seconds, > 0 and <= 120.
VISION_EMBEDDINGS_INFERENCE_TIMEOUT_SECONDS=60
# Authentication lockout on the CPU gateway only (per gateway process).
# Locked peers cannot try any token, including the correct one, until expiry.
# The third failed Bearer-token attempt returns HTTP 429 for 15 minutes.
VISION_EMBEDDINGS_AUTH_FAILURE_LIMIT=3
VISION_EMBEDDINGS_AUTH_FAILURE_WINDOW_SECONDS=300
VISION_EMBEDDINGS_AUTH_LOCKOUT_SECONDS=900
VISION_EMBEDDINGS_AUTH_MAX_TRACKED_CLIENTS=4096
# State resets on container restart; see docs/OPERATIONS.md.
# Separate Modal Secrets: API credential stays on the gateway only.
VISION_EMBEDDINGS_MODAL_SECRET_NAME=multimodal-embeddings-api
VISION_EMBEDDINGS_MODAL_MODEL_SECRET_NAME=multimodal-embeddings-model-config
VISION_EMBEDDINGS_MAX_IMAGE_PIXELS=12000000
# For Qwen adapter: official upstream source checked out and installed in this path
VISION_EMBEDDINGS_QWEN_SOURCE_PATH=/opt/Qwen3-VL-Embedding
# Pin to immutable Hugging Face commits before production benchmarking
VISION_EMBEDDINGS_WEMM9_REVISION=00c52839de57a6d4fd5b78cf5522ccf0ac8ea482
VISION_EMBEDDINGS_QWEN8_REVISION=2c4565515e0f265c6511776e7193b22c0968ddc7
# The same named Volume must be used by model downloads and inference.
VISION_EMBEDDINGS_QWEN_VOLUME_NAME=multimodal-embeddings-qwen-weights
VISION_EMBEDDINGS_WEMM_VOLUME_NAME=multimodal-embeddings-wemm-weights
# Each model uses a dedicated L40S, max_containers=1.
# Never commit real tokens or credentials.

# Runtime defaults mirrored from config.py (safe local example)
# Optional client registry. Empty registry keeps owner-token-only operation.
VISION_EMBEDDINGS_CLIENT_KEY_HASHES_JSON={}

# Outstanding async job permits (global and per stable client ID).
VISION_EMBEDDINGS_MAX_ASYNC_JOBS_GLOBAL=8
VISION_EMBEDDINGS_MAX_ASYNC_JOBS_PER_CLIENT=2

# Per-client embedding units/minute; bound concurrent POST body handling.
VISION_EMBEDDINGS_MAX_CLIENT_EMBEDDINGS_PER_MINUTE=60
VISION_EMBEDDINGS_MAX_BODY_REQUESTS=8

# Distributed admission OFF by default (local mock, one CPU gateway).
# Configure a private rediss:// endpoint separately for multi-gateway production.
VISION_EMBEDDINGS_DISTRIBUTED_RATE_LIMIT=0
VISION_EMBEDDINGS_RATE_REDIS_URL=
# Non-secret Redis key prefix; matches config.py even when Redis is disabled.
VISION_EMBEDDINGS_RATE_REDIS_NAMESPACE=multimodal-embeddings-v1
VISION_EMBEDDINGS_MAX_DISTRIBUTED_SYNC_INFLIGHT=4
VISION_EMBEDDINGS_MAX_DISTRIBUTED_CLIENT_SYNC_INFLIGHT=2

# One CPU gateway. Changing this requires a Modal deploy-time shell setting,
# not just a runtime Secret.
VISION_EMBEDDINGS_GATEWAY_MAX_CONTAINERS=1
