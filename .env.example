# Generate a unique token: python -c 'import secrets; print(secrets.token_urlsafe(48))'
CF_API_TOKEN=REPLACE_WITH_RANDOM_SECRET
# mock = deterministic integration stub; local = actual local GPU inference
CF_BACKEND=mock
CF_MAX_IMAGE_BYTES=5242880
CF_MAX_BATCH_SIZE=8
CF_MAX_IMAGE_PIXELS=12000000
# For Qwen adapter: official upstream source checked out and installed in this path
CF_QWEN_SOURCE_PATH=/opt/Qwen3-VL-Embedding
# Pin to immutable Hugging Face commits before production benchmarking
CF_WEMM9_REVISION=00c52839de57a6d4fd5b78cf5522ccf0ac8ea482
CF_QWEN8_REVISION=2c4565515e0f265c6511776e7193b22c0968ddc7
# Modal GPU is fixed to one L40S with max_containers=1.
# Never commit real tokens or credentials.
